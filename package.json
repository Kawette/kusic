{
  "name": "kusic",
  "version": "1.0.0",
  "description": "Agrégateur de playlists Spotify & SoundCloud avec téléchargement via Soulseek",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "node build.js",
    "watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --dev",
    "dist": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "dev.kusic.app",
    "productName": "Kusic",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    }
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "^39.8.10",
    "electron-builder": "^26.18.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "axios": "^1.21.1",
    "electron-store": "^8.1.0",
    "music-metadata": "^11.16.1",
    "node-taglib-sharp": "^6.0.3",
    "yaml": "^2.9.1"
  }
}
